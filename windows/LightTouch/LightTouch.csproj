<Project Sdk="Microsoft.NET.Sdk">
  <!-- Light Touch for Windows: the device library and, as `LightTouch.exe run DEVICE_DIR`, one running device
       (qemu-arm.dll, the qemu_ios_* ABI, can boot once per process, as LightTouchDevice is one process per device). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LightTouch</RootNamespace>
    <AssemblyName>LightTouch</AssemblyName>
    <Product>Light Touch for Windows</Product>
    <Description>Classic Apple devices on Windows</Description>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The firmware catalog the Mac app ships: which libraries media import may add to on each build (`media`). -->
    <EmbeddedResource Include="..\..\LightTouchMac\Resources\firmware-catalog.json" LogicalName="firmware-catalog.json" />
    <!-- The Mac app's flat device art (Board.Art): the bezel around the screen. -->
    <EmbeddedResource Include="..\..\LightTouchMac\Assets.xcassets\shell.imageset\shell_opaque.png" LogicalName="shell/shell.png" />
    <EmbeddedResource Include="..\..\LightTouchMac\Assets.xcassets\shell-1g.imageset\shell-1g.png" LogicalName="shell/shell-1g.png" />
    <EmbeddedResource Include="..\..\LightTouchMac\Assets.xcassets\shell-4g.imageset\shell-4g.png" LogicalName="shell/shell-4g.png" />
    <EmbeddedResource Include="..\..\LightTouchMac\Assets.xcassets\shell-iphone2g.imageset\shell-iphone2g.png" LogicalName="shell/shell-iphone2g.png" />
    <EmbeddedResource Include="..\..\LightTouchMac\Assets.xcassets\shell-iphone4.imageset\shell-iphone4.png" LogicalName="shell/shell-iphone4.png" />
    <EmbeddedResource Include="..\..\LightTouchMac\Assets.xcassets\ipad-frame.imageset\ipad-frame.png" LogicalName="shell/ipad-frame.png" />
  </ItemGroup>
</Project>
