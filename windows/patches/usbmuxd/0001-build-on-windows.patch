diff --git a/src/log.c b/src/log.c
index cd7c2d5..5563815 100644
--- a/src/log.c
+++ b/src/log.c
@@ -79,10 +79,12 @@ void usbmuxd_log(enum loglevel level, const char *fmt, ...)
 		struct tm *tp;
 
 		gettimeofday(&ts, NULL);
+		/* timeval's tv_sec is a 32-bit long on Win64, time_t 64 bits: pass a time_t, never &ts.tv_sec. */
+		time_t now = ts.tv_sec;
 #ifdef HAVE_LOCALTIME_R
-		tp = localtime_r(&ts.tv_sec, &tp_);
+		tp = localtime_r(&now, &tp_);
 #else
-		tp = localtime(&ts.tv_sec);
+		tp = localtime(&now);
 #endif
 
 		strftime(fs, 10, "[%H:%M:%S", tp);
diff --git a/src/usb-qemu.c b/src/usb-qemu.c
index ced8a59..8857b36 100644
--- a/src/usb-qemu.c
+++ b/src/usb-qemu.c
@@ -1095,10 +1095,20 @@ static void accept_pending(void)
 	 * short enough that a guest pegging its CPU (installd unpacking an app on
 	 * 128 MB) stalled QEMU's IO past it, and the "device" died mid-install
 	 * while both ends were actually fine. */
+#ifdef _WIN32
+	/* Windows takes the timeout as a DWORD of milliseconds (a timeval there reads as 30 ms), and an accepted socket
+	 * inherits the listener's non-blocking mode, which these blocking round trips must not have. */
+	(void)tv;
+	DWORD timeout_ms = 30000;
+	fcntl(fd, F_SETFL, 0);
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout_ms, sizeof(timeout_ms));
+	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout_ms, sizeof(timeout_ms));
+#else
 	tv.tv_sec = 30;
 	tv.tv_usec = 0;
 	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
 	setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+#endif
 
 	delayspec = getenv("USBMUXD_QEMU_DELAY");
 	delay = delayspec ? atoi(delayspec) : 0;
