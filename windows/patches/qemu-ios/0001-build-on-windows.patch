@@ -7,7 +7,38 @@
 #include "qapi/error.h"
 #include "system/runstate.h"
 #include "system/address-spaces.h"
+#ifdef _WIN32
+/* A read-only view of the whole file; the view keeps the file open after its descriptor closes, as mmap does. */
+static void *fmss_map_readonly(int fd)
+{
+    HANDLE mapping = CreateFileMappingA((HANDLE)_get_osfhandle(fd), NULL, PAGE_READONLY, 0, 0, NULL);
+    void *view;
+
+    if (!mapping) {
+        return NULL;
+    }
+    view = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0);
+    CloseHandle(mapping);
+    return view;
+}
+#define FMSS_MAP_FAILED NULL
+#define fmss_unmap(p, size) UnmapViewOfFile(p)
+/* A page file replaces its older self, as rename(2) does; the CRT's rename refuses an existing target. */
+static int fmss_rename(const char *from, const char *to)
+{
+    if (MoveFileExA(from, to, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+        return 0;
+    }
+    errno = GetLastError() == ERROR_ACCESS_DENIED ? EACCES : EIO;
+    return -1;
+}
+#define rename(from, to) fmss_rename(from, to)
+#else
 #include <sys/mman.h>
+#define fmss_map_readonly(fd) mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0)
+#define FMSS_MAP_FAILED MAP_FAILED
+#define fmss_unmap(p, size) munmap(p, size)
+#endif
 #include <sys/stat.h>
 #include "trace.h"
 #include "hw/trace-printf.h"
