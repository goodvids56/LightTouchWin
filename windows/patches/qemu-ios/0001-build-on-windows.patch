diff --git a/include/system/os-win32.h b/include/system/os-win32.h
index 22d72ba..eb8fc18 100644
--- a/include/system/os-win32.h
+++ b/include/system/os-win32.h
@@ -134,6 +134,24 @@ static inline void os_setup_limits(void)
 
 #define fsync _commit
 
+/* mingw's CRT has no memmem; the iOS boards search firmware images with it. */
+static inline void *memmem(const void *haystack, size_t haystack_len,
+                           const void *needle, size_t needle_len)
+{
+    const char *h = haystack;
+    size_t i;
+
+    if (needle_len == 0) {
+        return (void *)haystack;
+    }
+    for (i = 0; i + needle_len <= haystack_len; i++) {
+        if (h[i] == *(const char *)needle && memcmp(h + i, needle, needle_len) == 0) {
+            return (void *)(h + i);
+        }
+    }
+    return NULL;
+}
+
